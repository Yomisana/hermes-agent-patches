@@ -12,6 +12,7 @@
 
 from __future__ import annotations
 
+import contextlib
 import os
 import stat
 import sys
@@ -129,3 +130,143 @@ def test_created_file_mode_is_not_tightened(self, client, profile_dir: Path):
         assert r.status_code == 200, r.text
         mode = stat.S_IMODE(soul.stat().st_mode)
